# ============================================================================
# Compound Sentry Analytics - Environment Configuration
# Copy this to .env and fill in your values
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://analytics_user:your_password@localhost:5432/compound_sentry_analytics

# Enable SQL echo (verbose logging of SQL queries)
SQL_ECHO=false

# ============================================================================
# FASTAPI CONFIGURATION
# ============================================================================

# API Environment (development, staging, production)
ENVIRONMENT=development

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode
DEBUG=true

# API title
API_TITLE=Compound Sentry Analytics API

# ============================================================================
# REDIS CONFIGURATION (for caching and task queue)
# ============================================================================

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Redis cache TTL in seconds
CACHE_TTL=3600

# ============================================================================
# CELERY CONFIGURATION (for background tasks)
# ============================================================================

# Celery broker URL
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/analytics.log

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ============================================================================
# SECURITY
# ============================================================================

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# JWT token expiration in minutes
JWT_EXPIRATION_MINUTES=30

# ============================================================================
# DATA RETENTION POLICIES
# ============================================================================

# Days to keep raw device events
EVENT_RETENTION_DAYS=90

# Days to keep hourly aggregates
HOURLY_RETENTION_DAYS=90

# Days to keep dashboard activity logs
ACTIVITY_LOG_RETENTION_DAYS=180

# ============================================================================
# BACKGROUND JOBS CONFIGURATION
# ============================================================================

# Enable background job scheduler
SCHEDULER_ENABLED=true

# Daily aggregation job time (HH:MM format, UTC)
DAILY_AGGREGATION_TIME=00:00

# Hourly aggregation job schedule (minutes, 0-59)
HOURLY_AGGREGATION_SCHEDULE=0

# Weekly rollup schedule (day 0-6, 0=Monday)
WEEKLY_ROLLUP_DAY=0

# Weekly rollup time (HH:MM format, UTC)
WEEKLY_ROLLUP_TIME=02:00

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Timezone for analytics (IANA timezone)
TIMEZONE=UTC

# Signal strength threshold for poor signal alert (dBm)
POOR_SIGNAL_THRESHOLD=-70

# Minimum consecutive disconnections to trigger alert
FREQUENT_DISCONNECT_THRESHOLD=5

# Maximum time window for frequent disconnects (minutes)
DISCONNECT_TIME_WINDOW=60

# ============================================================================
# INTEGRATION WITH COMPOUND SENTRY
# ============================================================================

# Compound Sentry API endpoint (for syncing data)
COMPOUND_SENTRY_API_URL=http://localhost:5000/api

# Compound Sentry API key (if authentication required)
COMPOUND_SENTRY_API_KEY=your-api-key-here

# Sync interval (minutes)
SYNC_INTERVAL_MINUTES=5

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================

# Email configuration for alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Alert recipient emails (comma-separated)
ALERT_RECIPIENTS=admin@example.com,ops@example.com

# ============================================================================
# MONITORING & METRICS (Optional)
# ============================================================================

# Enable Prometheus metrics
PROMETHEUS_METRICS_ENABLED=false

# Prometheus metrics port
PROMETHEUS_PORT=9090

# Enable application performance monitoring (APM)
APM_ENABLED=false

# APM service name
APM_SERVICE_NAME=compound-sentry-analytics
