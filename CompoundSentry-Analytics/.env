# Compound Sentry Analytics - Runtime Environment
# Generated from .env.example and aligned with the main Compound Sentry project.

# PostgreSQL connection string
DATABASE_URL=postgresql://analytics_user:your_password@LETTING:5432/compound_sentry_analytics

# Enable SQL echo (verbose logging of SQL queries)
SQL_ECHO=false

# FASTAPI CONFIGURATION
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
API_TITLE=Compound Sentry Analytics API

# REDIS CONFIGURATION (for caching and task queue)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# CELERY CONFIGURATION (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LOGGING CONFIGURATION
LOG_LEVEL=INFO
LOG_FILE=./logs/analytics.log

# CORS CONFIGURATION
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# SECURITY
SECRET_KEY=da139ef8ce54dd7b796c5cdbaf0f81b309ee487858032538b9f668e667ba64c7
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# DATA RETENTION POLICIES
EVENT_RETENTION_DAYS=90
HOURLY_RETENTION_DAYS=90
ACTIVITY_LOG_RETENTION_DAYS=180

# BACKGROUND JOBS CONFIGURATION
SCHEDULER_ENABLED=true
DAILY_AGGREGATION_TIME=00:00
HOURLY_AGGREGATION_SCHEDULE=0
WEEKLY_ROLLUP_DAY=0
WEEKLY_ROLLUP_TIME=02:00

# ANALYTICS CONFIGURATION
TIMEZONE=UTC
POOR_SIGNAL_THRESHOLD=-70
FREQUENT_DISCONNECT_THRESHOLD=5
DISCONNECT_TIME_WINDOW=60

# INTEGRATION WITH COMPOUND SENTRY
COMPOUND_SENTRY_API_URL=http://localhost:5287/api
COMPOUND_SENTRY_API_KEY=your-api-key-here
SYNC_INTERVAL_MINUTES=5

# EXTERNAL SERVICES (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=castrokimaru@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENTS=admin@example.com,ops@example.com

# MONITORING & METRICS (Optional)
PROMETHEUS_METRICS_ENABLED=false
PROMETHEUS_PORT=9090
APM_ENABLED=false
APM_SERVICE_NAME=compound-sentry-analytics
