@{
    ViewData["Title"] = "Devices - Compound Sentry";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Devices - Compound Sentry</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #000080 0%, #1a1a6e 50%, #000060 100%);
            background-size: 200% 200%;
            animation: gradientFlow 8s ease infinite;
            min-height: 100vh;
            color: #e5e7eb;
        }

        @@keyframes gradientFlow {
            0% { background-position: 0% 0%; }
            25% { background-position: 100% 0%; }
            50% { background-position: 100% 100%; }
            75% { background-position: 0% 100%; }
            100% { background-position: 0% 0%; }
        }

        .container { display: flex; min-height: 100vh; }

        .sidebar {
            width: 280px;
            background: linear-gradient(135deg, rgba(0, 0, 128, 0.95), rgba(26, 26, 110, 0.95));
            backdrop-filter: blur(10px);
            border-right: 1px solid rgba(255, 255, 255, 0.15);
            padding: 24px 20px;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
        }

        .logo { display: flex; align-items: center; gap: 12px; padding-bottom: 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.15); margin-bottom: 24px; }
        .logo-icon { width: 40px; height: 40px; background: linear-gradient(135deg, #4a4aff, #000080); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; animation: iconPulse 3s ease infinite; }
        @@keyframes iconPulse { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
        .logo-text { font-size: 18px; font-weight: 700; background: linear-gradient(135deg, #8888ff, #4a4aff, #000080); background-size: 200% 200%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: textFlow 3s ease infinite; }
        @@keyframes textFlow { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

        .nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; margin: 4px 0; border-radius: 10px; color: #b0b0e0; transition: all 0.3s ease; cursor: pointer; text-decoration: none; }
        .nav-item:hover, .nav-item.active { background: linear-gradient(90deg, rgba(74, 74, 255, 0.2), rgba(0, 0, 128, 0.2)); color: #8888ff; border-left: 2px solid #8888ff; }
        .nav-item i { width: 20px; font-size: 18px; }

        .main-content { flex: 1; margin-left: 280px; padding: 24px 32px; }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 24px;
            background: linear-gradient(135deg, rgba(0, 0, 128, 0.5), rgba(26, 26, 110, 0.5));
            backdrop-filter: blur(10px);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 24px;
        }

        .page-title { font-size: 24px; font-weight: 600; background: linear-gradient(135deg, #8888ff, #4a4aff); -webkit-background-clip: text; background-clip: text; color: transparent; }

        .user-info { position: relative; cursor: pointer; display: flex; align-items: center; gap: 16px; z-index: 10001; }
        .avatar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: linear-gradient(135deg, #8888ff, #000080); border-radius: 40px; cursor: pointer; transition: all 0.3s ease; }
        .avatar:hover { transform: scale(1.05); box-shadow: 0 0 15px rgba(136, 136, 255, 0.5); }

        .dropdown-menu {
            position: absolute;
            top: 55px;
            right: 0;
            background: linear-gradient(135deg, rgba(0, 0, 128, 0.98), rgba(26, 26, 110, 0.98));
            backdrop-filter: blur(10px);
            border-radius: 12px;
            border: 1px solid rgba(136, 136, 255, 0.4);
            min-width: 220px;
            display: none;
            z-index: 10000 !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }
        .dropdown-menu.show { display: block; animation: fadeIn 0.2s ease; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        .dropdown-menu a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: #e5e7eb; text-decoration: none; transition: all 0.2s ease; }
        .dropdown-menu a:hover { background: rgba(136, 136, 255, 0.2); }
        .dropdown-menu hr { margin: 5px 0; border-color: rgba(136, 136, 255, 0.2); }

        .search-box { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
        .search-box input { flex: 1; padding: 10px 16px; background: rgba(0, 0, 128, 0.4); border: 1px solid rgba(136, 136, 255, 0.3); border-radius: 8px; color: #fff; min-width: 200px; }
        .search-box input:focus { outline: none; border-color: #8888ff; }

        .card { background: linear-gradient(135deg, rgba(0, 0, 128, 0.5), rgba(26, 26, 110, 0.5)); backdrop-filter: blur(10px); border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 24px; overflow: hidden; }
        .card-header { padding: 16px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); font-weight: 600; background: linear-gradient(90deg, rgba(136, 136, 255, 0.05), transparent); color: #c0c0f0; }

        .table-responsive { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 12px 20px; text-align: left; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
        th { color: #b0b0e0; font-weight: 500; font-size: 12px; text-transform: uppercase; }
        td { color: #d0d0f0; }
        tr:hover { background: rgba(136, 136, 255, 0.05); }

        .status { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 12px; }
        .status.online { background: rgba(16, 185, 129, 0.2); color: #10b981; }
        .status.offline { background: rgba(107, 114, 128, 0.2); color: #9ca3af; }

        .device-mac { font-family: monospace; font-size: 12px; letter-spacing: 0.5px; }

        @@media (max-width: 1024px) {
            .sidebar { width: 80px; }
            .logo-text, .nav-item span { display: none; }
            .main-content { margin-left: 80px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <div class="logo">
                <div class="logo-icon">👁️</div>
                <div class="logo-text">Compound Sentry</div>
            </div>
            <a href="/Dashboard" class="nav-item"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Devices" class="nav-item active"><i class="fas fa-mobile-alt"></i><span>Devices</span></a>
            <a href="/Dashboard/Analytics" class="nav-item"><i class="fas fa-chart-line"></i><span>Analytics</span></a>
            <a href="/Dashboard/Settings" class="nav-item"><i class="fas fa-cog"></i><span>Settings</span></a>
        </div>

        <div class="main-content">
            <div class="header">
                <h1 class="page-title">Devices Management</h1>
                <div class="user-info">
                    <span id="adminName">Admin</span>
                    <div class="avatar" id="avatarButton" onclick="toggleDropdown()">
                        👤 <i class="fas fa-chevron-down" style="font-size: 12px; margin-left: 5px;"></i>
                    </div>
                    <div class="dropdown-menu" id="dropdownMenu">
                        <a href="/Dashboard/MyProfile"><i class="fas fa-user"></i> My Profile</a>
                        <a href="/Dashboard/AdminSettings"><i class="fas fa-cog"></i> Settings</a>
                        <hr>
                        <a href="/Account/Logout" style="color: #ef4444;"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                    </div>
                </div>
            </div>

            <!-- Search Box Only -->
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Search by MAC address or device name..." onkeyup="filterDevices()">
            </div>

            <div class="card">
                <div class="card-header"><i class="fas fa-mobile-alt"></i> All Detected Devices</div>
                <div class="table-responsive">
                    <table id="devicesTable">
                        <thead>
                            <tr>
                                <th>MAC Address</th>
                                <th>Device Name</th>
                                <th>IP Address</th>
                                <th>First Seen</th>
                                <th>Last Seen</th>
                                <th>Total Visits</th>
                                <th>Total Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="devicesTableBody">
                            <tr><td colspan="8" style="text-align:center">Loading devices...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        var allDevices = [];
        var inactivityTimer = null;

        // DROPDOWN FUNCTIONS
        var avatarButton = document.getElementById('avatarButton');
        var dropdownMenu = document.getElementById('dropdownMenu');

        function toggleDropdown() {
        if (dropdownMenu) {
        dropdownMenu.classList.toggle('show');
        }
        }

        if (avatarButton) {
        avatarButton.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleDropdown();
        });
        }

        document.addEventListener('click', function(e) {
        if (dropdownMenu && avatarButton && !avatarButton.contains(e.target) && !dropdownMenu.contains(e.target)) {
        dropdownMenu.classList.remove('show');
        }
        });

        document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && dropdownMenu) {
        dropdownMenu.classList.remove('show');
        }
        });

        // RENDER FUNCTION - USING LOWERCASE PROPERTIES
        function renderDevices() {
        var searchTerm = document.getElementById('searchInput')?.value.toLowerCase() || '';
        var filtered = allDevices.filter(function(d) {
        return (d.macAddress && d.macAddress.toLowerCase().includes(searchTerm)) ||
        (d.deviceName && d.deviceName.toLowerCase().includes(searchTerm)) ||
        (d.ipAddress && d.ipAddress.toLowerCase().includes(searchTerm));
        });

        var tbody = document.getElementById('devicesTableBody');
        if (tbody) {
        if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center">No devices found</td></tr>';
        return;
        }

        var html = '';
        for (var i = 0; i < filtered.length; i++) {
        var d = filtered[i];
        var statusClass = d.isOnline ? 'online' : 'offline';
        var statusText = d.isOnline ? '● Online' : '○ Offline';
        var totalTime = d.totalTimeMinutes ? d.totalTimeMinutes + ' min' : '-';
        var firstSeenStr = d.firstSeen ? new Date(d.firstSeen).toLocaleString() : '-';
        var lastSeenStr = d.lastSeen ? new Date(d.lastSeen).toLocaleString() : '-';
        var ipAddress = d.ipAddress || 'Unknown';

        html += '<tr>' +
        '<td><span class="device-mac">' + (d.macAddress || 'N/A') + '</span></td>' +
        '<td>' + (d.deviceName || 'Unknown') + '</td>' +
        '<td>' + ipAddress + '</td>' +
        '<td>' + firstSeenStr + '</td>' +
        '<td>' + lastSeenStr + '</td>' +
        '<td>' + (d.totalVisits || 0) + '</td>' +
        '<td>' + totalTime + '</td>' +
        '<td><span class="status ' + statusClass + '">' + statusText + '</span></td>' +
        '</tr>';
        }
        tbody.innerHTML = html;
        }
        }function renderDevices() {
        var searchTerm = document.getElementById('searchInput')?.value.toLowerCase() || '';
        var filtered = allDevices.filter(function(d) {
        return (d.macAddress && d.macAddress.toLowerCase().includes(searchTerm)) ||
        (d.deviceName && d.deviceName.toLowerCase().includes(searchTerm)) ||
        (d.ipAddress && d.ipAddress.toLowerCase().includes(searchTerm));
        });

        var tbody = document.getElementById('devicesTableBody');
        if (tbody) {
        if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center">No devices found<\/td><\/tr>';
        return;
        }

        var html = '';
        for (var i = 0; i < filtered.length; i++) {
        var d = filtered[i];
        var statusClass = d.isOnline ? 'online' : 'offline';
        var statusText = d.isOnline ? '● Online' : '○ Offline';
        var totalTime = d.totalTimeMinutes ? d.totalTimeMinutes + ' min' : '-';
        var firstSeenStr = d.firstSeen ? new Date(d.firstSeen).toLocaleString() : '-';
        var ipAddress = d.ipAddress || 'Unknown';

        // Only show Last Seen for OFFLINE devices, empty for online devices
        var lastSeenStr = '';
        if (!d.isOnline && d.lastSeen) {
        lastSeenStr = new Date(d.lastSeen).toLocaleString();
        } else if (!d.isOnline) {
        lastSeenStr = '-';
        }
        // For online devices, lastSeenStr remains empty string

        html += '<tr>' +
        '<td><span class="device-mac">' + (d.macAddress || 'N/A') + '</span></td>' +
        '<td>' + (d.deviceName || 'Unknown') + '</td>' +
        '<td>' + ipAddress + '</td>' +
        '<td>' + firstSeenStr + '</td>' +
        '<td>' + lastSeenStr + '</td>' +
        '<td>' + (d.totalVisits || 0) + '</td>' +
        '<td>' + totalTime + '</td>' +
        '<td><span class="status ' + statusClass + '">' + statusText + '</span></td>' +
        '</tr>';
        }
        tbody.innerHTML = html;
        }
        }

        // LOAD DEVICES FROM API
        async function loadDevices() {
        try {
        var response = await fetch('/api/devices/all');
        if (response.ok) {
        var devices = await response.json();
        allDevices = devices;
        console.log('Loaded ' + allDevices.length + ' devices');
        renderDevices();
        } else {
        console.error('Failed to load devices:', response.status);
        }
        } catch (err) {
        console.error('Error loading devices:', err);
        }
        }

        // SIGNALR CONNECTION FOR REAL-TIME UPDATES
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/dashboardHub")
        .configureLogging(signalR.LogLevel.Information)
        .build();

        connection.start().catch(err => console.error(err));

        connection.on("ReceiveCurrentDevices", function(devices) {
        console.log("Real-time update received, reloading devices...");
        loadDevices();
        });

        connection.on("ReceiveRecentActivity", function(activities) {
        console.log("Activity update received, reloading devices...");
        loadDevices();
        });

        // INACTIVITY LOGOUT
        function resetInactivityTimer() {
        if (inactivityTimer) clearTimeout(inactivityTimer);
        inactivityTimer = setTimeout(function() { window.location.href = '/Account/Logout'; }, 120000);
        }

        var events = ['mousedown', 'mousemove', 'keypress', 'scroll', 'click', 'keydown'];
        for (var i = 0; i < events.length; i++) {
        document.addEventListener(events[i], resetInactivityTimer);
        }
        resetInactivityTimer();

        // INITIALIZE
        loadDevices();
        setInterval(loadDevices, 30000);
    </script>
    </body>
    </html>