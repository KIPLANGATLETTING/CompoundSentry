@{
    ViewData["Title"] = "Settings - Compound Sentry";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Compound Sentry</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background: linear-gradient(135deg, #000080 0%, #1a1a6e 50%, #000060 100%);
                background-size: 200% 200%;
                animation: gradientFlow 8s ease infinite;
                min-height: 100vh;
                color: #e5e7eb;
            }

            @@keyframes gradientFlow {
                0% {
                    background-position: 0% 0%;
                }

                25% {
                    background-position: 100% 0%;
                }

                50% {
                    background-position: 100% 100%;
                }

                75% {
                    background-position: 0% 100%;
                }

                100% {
                    background-position: 0% 0%;
                }
            }

            .container {
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 280px;
                background: linear-gradient(135deg, rgba(0, 0, 128, 0.95), rgba(26, 26, 110, 0.95));
                backdrop-filter: blur(10px);
                border-right: 1px solid rgba(255, 255, 255, 0.15);
                padding: 24px 20px;
                position: fixed;
                height: 100vh;
                overflow-y: auto;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                padding-bottom: 24px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.15);
                margin-bottom: 24px;
            }

            .logo-icon {
                width: 40px;
                height: 40px;
                background: linear-gradient(135deg, #4a4aff, #000080);
                background-size: 200% 200%;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                animation: iconPulse 3s ease infinite;
            }

            @@keyframes iconPulse {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            .logo-text {
                font-size: 18px;
                font-weight: 700;
                background: linear-gradient(135deg, #8888ff, #4a4aff, #000080);
                background-size: 200% 200%;
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                animation: textFlow 3s ease infinite;
            }

            @@keyframes textFlow {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                margin: 4px 0;
                border-radius: 10px;
                color: #b0b0e0;
                transition: all 0.3s ease;
                cursor: pointer;
                text-decoration: none;
            }

                .nav-item:hover, .nav-item.active {
                    background: linear-gradient(90deg, rgba(74, 74, 255, 0.2), rgba(0, 0, 128, 0.2));
                    color: #8888ff;
                    border-left: 2px solid #8888ff;
                }

                .nav-item i {
                    width: 20px;
                    font-size: 18px;
                }

            .main-content {
                flex: 1;
                margin-left: 280px;
                padding: 24px 32px;
            }

            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 16px 24px;
                background: linear-gradient(135deg, rgba(0, 0, 128, 0.5), rgba(26, 26, 110, 0.5));
                backdrop-filter: blur(10px);
                border-radius: 16px;
                border: 1px solid rgba(255, 255, 255, 0.1);
                margin-bottom: 24px;
                position: relative;
                z-index: 1000;
            }

            .page-title {
                font-size: 24px;
                font-weight: 600;
                background: linear-gradient(135deg, #8888ff, #4a4aff);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: 16px;
                position: relative;
                z-index: 10001;
            }

            .avatar {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 12px;
                background: linear-gradient(135deg, #8888ff, #000080);
                border-radius: 40px;
                cursor: pointer;
                transition: all 0.3s ease;
                position: relative;
                z-index: 10001;
            }

                .avatar:hover {
                    transform: scale(1.05);
                    box-shadow: 0 0 15px rgba(136, 136, 255, 0.5);
                }

            .dropdown-menu {
                position: absolute;
                top: 55px;
                right: 0;
                background: linear-gradient(135deg, rgba(0, 0, 128, 0.98), rgba(26, 26, 110, 0.98));
                backdrop-filter: blur(10px);
                border-radius: 12px;
                border: 1px solid rgba(136, 136, 255, 0.4);
                min-width: 220px;
                display: none;
                z-index: 10000 !important;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            }

                .dropdown-menu.show {
                    display: block;
                    animation: fadeIn 0.2s ease;
                }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .dropdown-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #e5e7eb;
                text-decoration: none;
                transition: all 0.2s ease;
            }

                .dropdown-menu a:hover {
                    background: rgba(136, 136, 255, 0.2);
                }

            .dropdown-menu hr {
                margin: 5px 0;
                border-color: rgba(136, 136, 255, 0.2);
            }

            .card {
                background: linear-gradient(135deg, rgba(0, 0, 128, 0.5), rgba(26, 26, 110, 0.5));
                backdrop-filter: blur(10px);
                border-radius: 16px;
                border: 1px solid rgba(255, 255, 255, 0.1);
                margin-bottom: 24px;
                overflow: hidden;
            }

            .card-header {
                padding: 16px 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                font-weight: 600;
                background: linear-gradient(90deg, rgba(136, 136, 255, 0.05), transparent);
                color: #c0c0f0;
            }

            .settings-group {
                padding: 20px;
            }

            .setting-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 12px 0;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

            .setting-label {
                font-weight: 500;
                color: #d0d0f0;
            }

            .setting-value select, .setting-value input {
                background: rgba(0, 0, 128, 0.4);
                border: 1px solid rgba(136, 136, 255, 0.3);
                padding: 8px 12px;
                border-radius: 8px;
                color: #fff;
            }

                .setting-value select:focus, .setting-value input:focus {
                    outline: none;
                    border-color: #8888ff;
                }

                .setting-value input[type="checkbox"] {
                    width: 18px;
                    height: 18px;
                    cursor: pointer;
                }

            .btn-save {
                margin-top: 20px;
                padding: 12px 24px;
                background: linear-gradient(135deg, #4a4aff, #000080);
                border: none;
                border-radius: 8px;
                color: #fff;
                cursor: pointer;
                font-weight: 600;
                transition: transform 0.2s;
            }

                .btn-save:hover {
                    transform: scale(1.02);
                }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 80px;
                }

                .logo-text, .nav-item span {
                    display: none;
                }

                .main-content {
                    margin-left: 80px;
                }
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <div class="logo"><div class="logo-icon">👁️</div><div class="logo-text">Compound Sentry</div></div>
            <a href="/Dashboard" class="nav-item"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Devices" class="nav-item"><i class="fas fa-mobile-alt"></i><span>Devices</span></a>
            <a href="/Dashboard/Analytics" class="nav-item"><i class="fas fa-chart-line"></i><span>Analytics</span></a>
            <a href="/Dashboard/Settings" class="nav-item active"><i class="fas fa-cog"></i><span>Settings</span></a>
        </div>

        <div class="main-content">
            <div class="header">
                <h1 class="page-title">System Settings</h1>
                <div class="user-info">
                    <span id="adminName">Admin</span>
                    <div class="avatar" id="avatarButton" onclick="toggleDropdown()">
                        👤
                        <i class="fas fa-chevron-down" style="font-size: 12px; margin-left: 5px;"></i>
                    </div>
                    <div class="dropdown-menu" id="dropdownMenu">
                        <a href="/Dashboard/MyProfile"><i class="fas fa-user"></i> My Profile</a>
                        <a href="/Dashboard/AdminSettings"><i class="fas fa-cog"></i> Settings</a>
                        <hr>
                        <a href="/Account/Logout" style="color: #ef4444;"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">⚙️ General Settings</div>
                <div class="settings-group">
                    <div class="setting-item"><div class="setting-label">Scanning Interval</div><div class="setting-value"><select id="scanInterval"><option>5 seconds</option><option>10 seconds</option><option>30 seconds</option><option>60 seconds</option></select></div></div>
                    <div class="setting-item"><div class="setting-label">Device Timeout (Exit after)</div><div class="setting-value"><select id="timeout"><option>1 minute</option><option selected>5 minutes</option><option>10 minutes</option><option>30 minutes</option></select></div></div>
                    <div class="setting-item"><div class="setting-label">Real-time Updates</div><div class="setting-value"><select id="realtime"><option selected>Enabled</option><option>Disabled</option></select></div></div>
                    <div class="setting-item"><div class="setting-label">Data Retention (days)</div><div class="setting-value"><input type="number" id="retention" value="30"></div></div>
                    <button class="btn-save" onclick="saveSettings()">Save Changes</button>
                </div>
            </div>

            <div class="card">
                <div class="card-header">🔔 Notification Settings</div>
                <div class="settings-group">
                    <div class="setting-item"><div class="setting-label">Email Alerts</div><div class="setting-value"><input type="checkbox" id="emailAlerts"> Enable</div></div>
                    <div class="setting-item"><div class="setting-label">Alert Email</div><div class="setting-value"><input type="email" id="alertEmail" placeholder="admin@example.com"></div></div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">🛡️ Security</div>
                <div class="settings-group">
                    <div class="setting-item"><div class="setting-label">Change Password</div><div class="setting-value"><button class="btn-save" onclick="changePassword()">Change Password</button></div></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // ========== DROPDOWN MENU ==========
        const avatarButton = document.getElementById('avatarButton');
        const dropdownMenu = document.getElementById('dropdownMenu');

        function toggleDropdown() {
        if (dropdownMenu) {
        dropdownMenu.classList.toggle('show');
        }
        }

        if (avatarButton) {
        avatarButton.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleDropdown();
        });
        }

        document.addEventListener('click', function(e) {
        if (dropdownMenu && avatarButton && !avatarButton.contains(e.target) && !dropdownMenu.contains(e.target)) {
        dropdownMenu.classList.remove('show');
        }
        });

        document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && dropdownMenu) {
        dropdownMenu.classList.remove('show');
        }
        });

        // ========== SETTINGS PAGE FUNCTIONS ==========
        function saveSettings() {
        alert("Settings saved successfully!");
        }

        function changePassword() {
        alert("Redirecting to password change...");
        window.location.href = "/Dashboard/AdminSettings";
        }

        // ========== INACTIVITY LOGOUT (120 seconds) ==========
        let inactivityTimer;

        function resetInactivityTimer() {
        if (inactivityTimer) clearTimeout(inactivityTimer);
        inactivityTimer = setTimeout(logoutUser, 120000);
        }

        function logoutUser() {
        window.location.href = '/Account/Logout';
        }

        const activities = ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click', 'keydown'];
        activities.forEach(eventName => {
        document.addEventListener(eventName, resetInactivityTimer);
        });

        resetInactivityTimer();
    </script>
</body>
</html>