@{
    ViewData["Title"] = "Analytics - Compound Sentry";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics - Compound Sentry</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        }

        body {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(135deg, #000080 0%, #1a1a6e 50%, #000060 100%);
        background-size: 200% 200%;
        animation: gradientFlow 8s ease infinite;
        min-height: 100vh;
        color: #e5e7eb;
        }

        @@keyframes gradientFlow {
        0% {
        background-position: 0% 0%;
        }

        25% {
        background-position: 100% 0%;
        }

        50% {
        background-position: 100% 100%;
        }

        75% {
        background-position: 0% 100%;
        }

        100% {
        background-position: 0% 0%;
        }
        }

        .container {
        display: flex;
        min-height: 100vh;
        }

        .sidebar {
        width: 280px;
        background: linear-gradient(135deg, rgba(0, 0, 128, 0.95), rgba(26, 26, 110, 0.95));
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.15);
        padding: 24px 20px;
        position: fixed;
        height: 100vh;
        overflow-y: auto;
        }

        .logo {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        margin-bottom: 24px;
        }

        .logo-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #4a4aff, #000080);
        background-size: 200% 200%;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        animation: iconPulse 3s ease infinite;
        }

        @@keyframes iconPulse {
        0% {
        background-position: 0% 50%;
        }

        50% {
        background-position: 100% 50%;
        }

        100% {
        background-position: 0% 50%;
        }
        }

        .logo-text {
        font-size: 18px;
        font-weight: 700;
        background: linear-gradient(135deg, #8888ff, #4a4aff, #000080);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: textFlow 3s ease infinite;
        }

        @@keyframes textFlow {
        0% {
        background-position: 0% 50%;
        }

        50% {
        background-position: 100% 50%;
        }

        100% {
        background-position: 0% 50%;
        }
        }

        .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        margin: 4px 0;
        border-radius: 10px;
        color: #b0b0e0;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        }

        .nav-item:hover, .nav-item.active {
        background: linear-gradient(90deg, rgba(74, 74, 255, 0.2), rgba(0, 0, 128, 0.2));
        color: #8888ff;
        border-left: 2px solid #8888ff;
        }

        .nav-item i {
        width: 20px;
        font-size: 18px;
        }

        .main-content {
        flex: 1;
        margin-left: 280px;
        padding: 24px 32px;
        }

        .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        background: linear-gradient(135deg, rgba(0, 0, 128, 0.5), rgba(26, 26, 110, 0.5));
        backdrop-filter: blur(10px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 24px;
        position: relative;
        z-index: 1000;
        }

        .user-info {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 10001;
        }

        .avatar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: linear-gradient(135deg, #8888ff, #000080);
        border-radius: 40px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        z-index: 10001;
        }

        .avatar:hover {
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(136, 136, 255, 0.5);
        }

        .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 32px;
        }

        .stat-card {
        background: linear-gradient(135deg, rgba(0, 0, 128, 0.6), rgba(26, 26, 110, 0.6));
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
        }

        .stat-card:hover {
        transform: translateY(-5px);
        border-color: rgba(136, 136, 255, 0.4);
        box-shadow: 0 10px 30px rgba(0, 0, 128, 0.3);
        }

        .stat-title {
        font-size: 13px;
        color: #b0b0e0;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        }

        .stat-value {
        font-size: 32px;
        font-weight: 700;
        background: linear-gradient(135deg, #8888ff, #4a4aff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        }

        .card {
        background: linear-gradient(135deg, rgba(0, 0, 128, 0.5), rgba(26, 26, 110, 0.5));
        backdrop-filter: blur(10px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 24px;
        overflow: hidden;
        padding: 20px;
        }

        .card-header {
        font-weight: 600;
        margin-bottom: 16px;
        color: #c0c0f0;
        }

        canvas {
        max-height: 300px;
        }

        .btn-logout {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(239, 68, 68, 0.1));
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 8px;
        width: 100%;
        transition: all 0.3s ease;
        }

        .btn-logout:hover {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.3), rgba(239, 68, 68, 0.2));
        border-color: rgba(239, 68, 68, 0.6);
        transform: translateX(5px);
        }

        @@media (max-width: 1024px) {
        .sidebar {
        width: 80px;
        }

        .logo-text, .nav-item span {
        display: none;
        }

        .main-content {
        margin-left: 80px;
        }

        .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        }
        }
        /* User dropdown - FIXED */
        .user-info {
        position: relative;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 10001;
        }

        .avatar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: linear-gradient(135deg, #8888ff, #000080);
        border-radius: 40px;
        cursor: pointer;
        transition: all 0.3s ease;
        }

        .avatar:hover {
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(136, 136, 255, 0.5);
        }

        .dropdown-menu {
        position: absolute;
        top: 55px;
        right: 0;
        background: linear-gradient(135deg, rgba(0, 0, 128, 0.98), rgba(26, 26, 110, 0.98));
        backdrop-filter: blur(10px);
        border-radius: 12px;
        border: 1px solid rgba(136, 136, 255, 0.4);
        min-width: 220px;
        display: none;
        z-index: 10000 !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .dropdown-menu.show {
        display: block;
        animation: fadeIn 0.2s ease;
        }

        @@keyframes fadeIn {
        from {
        opacity: 0;
        transform: translateY(-10px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        .dropdown-menu a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: #e5e7eb;
        text-decoration: none;
        transition: all 0.2s ease;
        }

        .dropdown-menu a:hover {
        background: rgba(136, 136, 255, 0.2);
        }

        .dropdown-menu hr {
        margin: 5px 0;
        border-color: rgba(136, 136, 255, 0.2);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <div class="logo"><div class="logo-icon">👁️</div><div class="logo-text">Compound Sentry</div></div>
            <a href="/Dashboard" class="nav-item"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Devices" class="nav-item"><i class="fas fa-mobile-alt"></i><span>Devices</span></a>
            <a href="/Dashboard/Analytics" class="nav-item active"><i class="fas fa-chart-line"></i><span>Analytics</span></a>
            <a href="/Dashboard/Settings" class="nav-item"><i class="fas fa-cog"></i><span>Settings</span></a>
        </div>

        <div class="main-content">
            <div class="header">
                <h1 class="page-title">Analytics Dashboard</h1>
                <div class="user-info">
                    <span id="adminName">Admin</span>
                    <div class="avatar" id="avatarDropdown" onclick="toggleDropdown()">
                        👤
                        <i class="fas fa-chevron-down" style="font-size: 12px; margin-left: 5px;"></i>
                    </div>
                    <div class="dropdown-menu" id="dropdownMenu">
                        <a href="/Dashboard/MyProfile">
                            <i class="fas fa-user"></i> My Profile
                        </a>
                        <a href="/Dashboard/AdminSettings">
                            <i class="fas fa-cog"></i> Settings
                        </a>
                        <hr>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card"><div class="stat-title">Total Devices (30d)</div><div class="stat-value" id="totalDevices30d">0</div></div>
                <div class="stat-card"><div class="stat-title">Avg Daily Visits</div><div class="stat-value" id="avgDaily">0</div></div>
                <div class="stat-card"><div class="stat-title">Peak Hour</div><div class="stat-value" id="peakHour">--</div></div>
                <div class="stat-card"><div class="stat-title">Return Rate</div><div class="stat-value" id="returnRate">0%</div></div>
            </div>

            <div class="card">
                <div class="card-header">📊 Daily Traffic (Last 7 Days)</div>
                <canvas id="trafficChart"></canvas>
            </div>

            <div class="card">
                <div class="card-header">📱 Top Device Models</div>
                <canvas id="devicesChart"></canvas>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // ========== CHARTS INITIALIZATION ==========
        const ctx1 = document.getElementById('trafficChart')?.getContext('2d');
        const ctx2 = document.getElementById('devicesChart')?.getContext('2d');

        let trafficChart, devicesChart;

        // Initialize empty charts
        if (ctx1) {
        trafficChart = new Chart(ctx1, {
        type: 'line',
        data: {
        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
        datasets: [{
        label: 'Entries',
        data: [0, 0, 0, 0, 0, 0, 0],
        borderColor: '#00e5ff',
        backgroundColor: 'rgba(0, 229, 255, 0.1)',
        tension: 0.4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
        legend: { labels: { color: '#e5e7eb' } }
        }
        }
        });
        }

        if (ctx2) {
        devicesChart = new Chart(ctx2, {
        type: 'bar',
        data: {
        labels: ['iPhone', 'Samsung', 'Pixel', 'Xiaomi', 'OnePlus', 'Uknown'],
        datasets: [{
        label: 'Detected Devices',
        data: [0, 0, 0, 0, 0, 0],
        backgroundColor: '#00e5ff',
        borderRadius: 8
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
        legend: { labels: { color: '#e5e7eb' } }
        }
        }
        });
        }

        // ========== SIGNALR CONNECTION ==========
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/dashboardHub")
        .configureLogging(signalR.LogLevel.Information)
        .build();

        connection.start().catch(err => console.error(err));

        // ========== FETCH REAL ANALYTICS DATA ==========
        async function loadAnalyticsData() {
        try {
        console.log("Loading analytics data...");

        // Fetch daily traffic data
        const trafficResponse = await fetch('/api/analytics/daily-traffic');
        if (trafficResponse.ok) {
        const trafficData = await trafficResponse.json();
        if (trafficChart && trafficData.length === 7) {
        trafficChart.data.datasets[0].data = trafficData;
        trafficChart.update();
        }
        }

        // Fetch device models data
        const modelsResponse = await fetch('/api/analytics/device-models');
        if (modelsResponse.ok) {
        const modelsData = await modelsResponse.json();
        if (devicesChart && modelsData.labels && modelsData.counts) {
        devicesChart.data.labels = modelsData.labels;
        devicesChart.data.datasets[0].data = modelsData.counts;
        devicesChart.update();
        }
        }

        // Fetch stats
        const statsResponse = await fetch('/api/analytics/stats');
        if (statsResponse.ok) {
        const stats = await statsResponse.json();
        document.getElementById('totalDevices30d').innerText = stats.total30Days || 0;
        document.getElementById('avgDaily').innerText = stats.avgDaily || 0;
        document.getElementById('peakHour').innerText = stats.peakHour || '--';
        document.getElementById('returnRate').innerText = (stats.returnRate || 0) + '%';
        }

        console.log("Analytics data loaded");
        } catch (error) {
        console.error('Error loading analytics:', error);
        }
        }

        // Load data on page load
        loadAnalyticsData();

        // Refresh every 30 seconds
        setInterval(loadAnalyticsData, 30000);

        // ========== DROPDOWN MENU ==========
        const avatarButton = document.getElementById('avatarButton');
        const dropdownMenu = document.getElementById('dropdownMenu');

        function toggleDropdown() {
        if (dropdownMenu) {
        dropdownMenu.classList.toggle('show');
        }
        }

        if (avatarButton) {
        avatarButton.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleDropdown();
        });
        }

        document.addEventListener('click', function(e) {
        if (dropdownMenu && avatarButton && !avatarButton.contains(e.target) && !dropdownMenu.contains(e.target)) {
        dropdownMenu.classList.remove('show');
        }
        });

        document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && dropdownMenu) {
        dropdownMenu.classList.remove('show');
        }
        });

        // ========== INACTIVITY LOGOUT (120 seconds) ==========
        let inactivityTimer;

        function resetInactivityTimer() {
        clearTimeout(inactivityTimer);
        inactivityTimer = setTimeout(logoutUser, 120000);
        }

        function logoutUser() {
        window.location.href = '/Account/Logout';
        }

        const activities = ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click', 'keydown'];
        activities.forEach(eventName => {
        document.addEventListener(eventName, resetInactivityTimer);
        });

        resetInactivityTimer();
    </script>
</body>
</html>